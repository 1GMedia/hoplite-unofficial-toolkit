{
  "name": "hoplite-unofficial-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial guarded Hoplite compatibility CLI and Codex skill",
  "type": "module",
  "scripts": {
    "hoplite": "bun packages/cli/src/index.ts",
    "hoplite-toolkit": "bun packages/cli/src/index.ts",
    "test": "bun test packages/cli/src",
    "api:check": "bun scripts/check-api-contract.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build packages/cli/src/index.ts --target bun --outdir dist",
    "operations:generate": "bun scripts/generate-operations.ts",
    "operations:check": "bun scripts/generate-operations.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/js-yaml": "4.0.9",
    "json-schema-to-ts": "3.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3"
  }
}
