# Read-only direct API access, when needed.
HOPLITE_API_KEY=

# Mutations fail closed unless the exact target thread IDs are listed here.
HOPLITE_MUTATION_ALLOWLIST=thr_example1,thr_example2

# Optional overrides.
HOPLITE_API_BASE_URL=https://api.hoplite.sh
HOPLITE_OAUTH_PATH=
HOPLITE_CREDENTIALS_PATH=
