# Read-only direct API access, when needed.
HOPLITE_API_KEY=

# Exact thread IDs for existing tasks; project:<id> authorizes task creation only.
HOPLITE_MUTATION_ALLOWLIST=thr_example1,fixturethread,project:fixtureproject

# Optional overrides.
HOPLITE_API_BASE_URL=https://api.hoplite.sh
# Official endpoint alias, used only when HOPLITE_API_BASE_URL is unset.
HOPLITE_BASE_URL=
HOPLITE_ORG_ID=
XDG_CONFIG_HOME=
HOPLITE_OAUTH_PATH=
# Optional legacy file adapter; official credentials/Keychain are not auto-read.
HOPLITE_CREDENTIALS_PATH=
